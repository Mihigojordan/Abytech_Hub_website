# Database connection string used by Prisma
DATABASE_URL=

# Secret used to sign/verify admin JWTs
Jwt_SECRET_KEY=

FRONTEND_URL_ONLY=http://localhost:5173

# Google OAuth (admin)
ADMIN_CALLBACK_URL=http://localhost:7000/admin/google/callback
ADMIN_CLIENT_SECRET=
ADMIN_CLIENT_ID=

# Google OAuth (employee)
EMPLOYEE_CALLBACK_URL=http://localhost:7000/employee/google/callback
EMPLOYEE_CLIENT_SECRET=
EMPLOYEE_CLIENT_ID=

# SMTP email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Cloudinary file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (VAPID) keys for push notifications
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Brevo transactional email
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ABYTECH HUB

FRONTEND_URL=http://localhost:5173

# Long random secret shared with the external "Backup-auto" service. It lets that
# unattended, cron-triggered service call POST /data-export/export without an
# interactive admin session, by sending it back in the `x-backup-api-key` header.
# Generate a long, random value (e.g. `openssl rand -hex 32`) and keep it secret -
# do not reuse any other credential for this.
BACKUP_SERVICE_API_KEY=
