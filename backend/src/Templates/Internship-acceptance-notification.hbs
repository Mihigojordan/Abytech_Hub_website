<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>Internship Accepted – AbyTech Hub</title>
<!--[if mso]><style type="text/css">body,table,td,a{font-family:Arial,sans-serif!important;}</style><![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#F4F2EE;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;-webkit-font-smoothing:antialiased;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#F4F2EE;">
<tr><td style="padding:40px 20px;">
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width:640px;margin:0 auto;background-color:#FFFFFF;box-shadow:0 4px 24px rgba(14,26,36,0.12);border-radius:2px;overflow:hidden;">

  <!-- TOP ACCENT BAR -->
  <tr><td style="height:6px;background:linear-gradient(90deg,#E85A1C 0%,#ff7043 100%);"></td></tr>

  <!-- HEADER -->
  <tr><td style="background:linear-gradient(135deg,#0E1A24 0%,#1a2a38 100%);padding:36px 40px 0;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td valign="top" style="width:60%;">
          <div style="font-size:28px;font-weight:800;color:#FFFFFF;line-height:1;letter-spacing:0.5px;font-family:Arial,sans-serif;">ABYTECH <span style="color:#E85A1C;">HUB</span></div>
          <div style="font-size:9px;color:#8A949E;text-transform:uppercase;letter-spacing:3px;margin-top:6px;font-weight:600;">TECHNOLOGY <span style="color:#E85A1C;">·</span> INNOVATION</div>
        </td>
        <td valign="top" style="width:40%;text-align:right;">
          <div style="font-size:8px;color:#E85A1C;text-transform:uppercase;letter-spacing:2px;font-weight:700;margin-bottom:6px;">STUDIO</div>
          <div style="font-size:11px;color:#C8CDD3;line-height:1.7;">
            <strong style="color:#FFFFFF;font-weight:600;">AbyTech Hub Ltd.</strong><br/>
            KN 3 Rd, Kigali, Rwanda<br/>
            <a href="mailto:info@abytechhub.com" style="color:#E85A1C;text-decoration:none;">info@abytechhub.com</a><br/>
            +250 792 888 980
          </div>
        </td>
      </tr>
    </table>
  </td></tr>

  <!-- HEADER TITLE STRIP -->
  <tr><td style="background:linear-gradient(135deg,#0E1A24 0%,#1a2a38 100%);padding:20px 40px 32px;border-top:1px solid rgba(255,255,255,0.08);">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td valign="bottom" style="width:55%;">
          <div style="font-size:8px;color:#8A949E;text-transform:uppercase;letter-spacing:3px;font-weight:600;margin-bottom:8px;">INTERNSHIP OFFER</div>
          <div style="font-size:48px;font-weight:800;color:#FFFFFF;line-height:0.9;letter-spacing:0.5px;font-family:Arial,sans-serif;">AC<br/><span style="color:#E85A1C;">CEPTED</span></div>
        </td>
        <td valign="bottom" style="width:45%;text-align:right;padding-bottom:4px;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-left:auto;">
            <tr>
              <td style="font-size:9px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;padding:0 12px 0 0;text-align:right;">INTERN</td>
              <td style="font-size:11px;color:#FFFFFF;font-weight:700;">{{fullName}}</td>
            </tr>
            <tr>
              <td style="font-size:9px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;padding:6px 12px 0 0;text-align:right;">PROGRAMME</td>
              <td style="font-size:11px;color:#FFFFFF;font-weight:700;padding-top:6px;">{{internshipType}}</td>
            </tr>
            <tr>
              <td style="font-size:9px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;padding:6px 12px 0 0;text-align:right;">YEAR</td>
              <td style="font-size:11px;color:#FFFFFF;font-weight:700;padding-top:6px;">{{year}}</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </td></tr>

  <!-- BODY -->
  <tr><td style="padding:40px 40px 36px;background-color:#FFFFFF;">

    <div style="display:inline-block;font-size:9px;color:#E85A1C;text-transform:uppercase;letter-spacing:3px;font-weight:700;border-bottom:3px solid #0E1A24;padding-bottom:8px;margin-bottom:20px;">INTERNSHIP ACCEPTANCE</div>

    <div style="font-size:26px;font-weight:700;color:#0E1A24;font-family:Arial,sans-serif;margin-bottom:16px;">Congratulations, {{fullName}}! &#127881;</div>

    <p style="font-size:14px;color:#5A6670;line-height:1.7;margin:0 0 20px;">
      We are thrilled to inform you that your application for the <strong style="color:#0E1A24;">{{internshipType}}</strong> internship at <strong style="color:#0E1A24;">AbyTech Hub</strong> has been accepted! We were impressed by your skills and enthusiasm.
    </p>

    <!-- Credentials Card -->
    <div style="font-size:9px;color:#E85A1C;text-transform:uppercase;letter-spacing:3px;font-weight:700;margin-bottom:12px;">YOUR ACCESS CREDENTIALS</div>
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#F8F6F2;border-left:4px solid #E85A1C;border-radius:2px;margin-bottom:16px;">
      <tr><td style="padding:20px 24px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
          <tr>
            <td style="font-size:10px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;padding:8px 16px 8px 0;border-bottom:1px solid #E3E6EA;width:35%;">Email</td>
            <td style="font-size:13px;color:#0E1A24;font-weight:600;padding:8px 0;border-bottom:1px solid #E3E6EA;">{{email}}</td>
          </tr>
          <tr>
            <td style="font-size:10px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;padding:8px 16px 8px 0;">Temp. Password</td>
            <td style="font-size:13px;padding:8px 0;">
              <span style="font-family:monospace;font-size:16px;color:#E85A1C;background:#eeeeee;padding:3px 10px;border-radius:3px;letter-spacing:1px;">{{password}}</span>
            </td>
          </tr>
        </table>
      </td></tr>
    </table>

    <!-- Security Notice -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#FFF8F5;border:1px solid rgba(232,90,28,0.2);border-radius:2px;margin-bottom:28px;">
      <tr><td style="padding:14px 18px;font-size:13px;color:#5A6670;line-height:1.6;">
        &#9888;&#65039; Please change your password after your first login for security purposes.
      </td></tr>
    </table>

    <!-- CTA -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr><td style="text-align:center;padding-bottom:28px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;">
          <tr><td style="background:linear-gradient(135deg,#E85A1C 0%,#ff7043 100%);border-radius:4px;box-shadow:0 4px 12px rgba(232,90,28,0.3);">
            <a href="{{dashboardUrl}}" style="display:inline-block;padding:16px 40px;font-size:13px;font-weight:700;color:#FFFFFF;text-decoration:none;text-transform:uppercase;letter-spacing:2px;font-family:Arial,sans-serif;">Access Dashboard</a>
          </td></tr>
        </table>
      </td></tr>
    </table>

    <p style="font-size:14px;color:#5A6670;line-height:1.7;margin:0;">
      If you have any questions, feel free to reach out to us. Welcome aboard!<br/><br/>
      Best regards,<br/><strong style="color:#0E1A24;">The AbyTech Hub Team</strong>
    </p>

  </td></tr>

  <!-- FOOTER -->
  <tr><td style="background:linear-gradient(135deg,#0E1A24 0%,#1a2a38 100%);padding:24px 40px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td valign="middle" style="width:60%;">
          <div style="font-size:22px;font-weight:800;color:#FFFFFF;letter-spacing:1px;font-family:Arial,sans-serif;">ABYTECH <span style="color:#E85A1C;">HUB</span></div>
          <div style="font-size:10px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;margin-top:6px;font-weight:500;">Innovation Starts Here</div>
        </td>
        <td valign="middle" style="width:40%;text-align:right;">
          <div style="font-size:10px;color:#8A949E;text-transform:uppercase;letter-spacing:2px;font-weight:500;">&copy; {{year}} AbyTech Hub<br/><strong style="color:#FFFFFF;font-weight:600;">Kigali, Rwanda</strong></div>
        </td>
      </tr>
    </table>
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top:20px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.08);">
      <tr><td style="text-align:center;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;">
          <tr>
            <td style="padding:0 8px;"><a href="https://www.abytechhub.com" style="color:#8A949E;text-decoration:none;font-size:11px;font-weight:500;">Website</a></td>
            <td style="color:#5A6670;">·</td>
            <td style="padding:0 8px;"><a href="mailto:info@abytechhub.com" style="color:#8A949E;text-decoration:none;font-size:11px;font-weight:500;">Email</a></td>
            <td style="color:#5A6670;">·</td>
            <td style="padding:0 8px;"><a href="tel:+250792888980" style="color:#8A949E;text-decoration:none;font-size:11px;font-weight:500;">Call Us</a></td>
          </tr>
        </table>
      </td></tr>
    </table>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
