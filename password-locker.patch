--- a/backend/prisma/schema.prisma
+++ b/backend/prisma/schema.prisma
@@ -82,6 +82,9 @@ model Admin {
   // Permission relation
   permissions AdminPermission[]
 
+  // Password locker (zero-knowledge vault)
